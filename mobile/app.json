{
  "expo": {
    "name": "LUXA",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "projectId": "4bb62ef7-86f4-4405-9a07-331b47dca6fb",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080E8C"
    },
    "extra": {
      "IP": "172.13.0.190",
      "router": {},
      "eas": {
        "projectId": "4bb62ef7-86f4-4405-9a07-331b47dca6fb"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jhonp.mobile",
      "scheme": "smartclass",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Google Sign-In",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.547526822972-016lvotaoihg5pn6i6cmp006dg50dvbg"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080E8C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jhonp.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "owner": "jhonl",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
